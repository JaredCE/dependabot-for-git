{
  "name": "dependabot-for-git",
  "version": "0.0.2",
  "private": false,
  "type": "module",
  "description": "Runs dependabot/cli update jobs against Bitbucket Cloud or GitLab repos and turns the results into real pull/merge requests.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "mocha \"test/**/*.test.mjs\""
  },
  "bin": {
    "dependabot-run-updates": "bin/run-updates.mjs",
    "dependabot-create-prs": "bin/create-bitbucket-prs.mjs"
  },
  "files": [
    "bin",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JaredCE/dependabot-for-git.git"
  },
  "bugs": {
    "url": "https://github.com/JaredCE/dependabot-for-git/issues"
  },
  "keywords": [
    "dependabot",
    "bitbucket",
    "dependency updates"
  ],
  "exports": {
    ".": "./src/run-updates.mjs",
    "./run-updates": "./src/run-updates.mjs",
    "./create-bitbucket-prs": "./src/create-bitbucket-prs.mjs"
  },
  "dependencies": {
    "js-yaml": "^5.2.3"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "mocha": "^11.8.0",
    "sinon": "^22.1.0"
  }
}
